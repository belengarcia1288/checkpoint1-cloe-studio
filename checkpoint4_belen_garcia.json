    {
      "parameters": {
        "jsCode": "const item = $input.all()[0].json;\n\nlet workerName = 'No determinado';\nlet paramsSent = 'N/A';\n\ntry {\n  const w1 = $('Call \\'Worker 1 - Calendar-Specialist\\'').all();\n  if (w1.length > 0) {\n    workerName = 'Worker 1 - Calendar-Specialist';\n    paramsSent = JSON.stringify($('Edit Fields').all()[0].json);\n  }\n} catch (e) {}\n\ntry {\n  const w2 = $('Call \\'Worker 2 - Catalogo-Servicios\\'').all();\n  if (w2.length > 0) {\n    workerName = 'Worker 2 - Catalogo-Servicios';\n    paramsSent = JSON.stringify($('Edit Fields1').all()[0].json);\n  }\n} catch (e) {}\n\nlet bodyContent = '';\n\nif (item.data && typeof item.data === 'string') {\n  let parsed;\n  try {\n    parsed = JSON.parse(item.data);\n  } catch (e) {\n    parsed = null;\n  }\n\n  if (Array.isArray(parsed)) {\n    bodyContent = `<p><b>¡Hola! Aquí tienes el detalle de los servicios y precios de Cloe Studio:</b></p><ul>`;\n    bodyContent += parsed.map(d => `<li><b>${d.SERVICIO}</b> - Precio: $${d.PRECIO} - Duración: ${d['DURACIÓN (EN MIN)']} min</li>`).join('');\n    bodyContent += `</ul>`;\n  } else {\n    bodyContent = `<p><b>Actualización de tu turno en Cloe Studio:</b></p><p>${item.data}</p>`;\n  }\n} else if (item.respuesta) {\n  bodyContent = `<p>${item.respuesta}</p>`;\n} else {\n  bodyContent = `<p>No se pudo generar el detalle de la respuesta.</p>`;\n}\n\nconst html = `<div style=\"text-align: center; font-family: sans-serif;\">\n  <img src=\"https://i.ibb.co/4RQKwqMr/logo-Cloe-Studio.jpg\" alt=\"Cloe Studio\" style=\"max-width: 100%; height: auto; border-radius: 8px; margin-bottom: 15px;\" />\n  ${bodyContent}\n  <hr style=\"margin: 20px 0;\" />\n  <div style=\"text-align: left; font-size: 12px; color: #666; font-family: monospace;\">\n    <b>— Log de Trazabilidad —</b><br/>\n    Worker invocado: ${workerName}<br/>\n    Estado: ${item.status || 'N/A'}<br/>\n    Parámetros enviados: ${paramsSent}<br/>\n    Respuesta recibida: ${JSON.stringify(item)}\n  </div>\n  <p style=\"font-family: sans-serif;\"><i>Registro generado automáticamente por la arquitectura multi-agente.</i></p>\n</div>`;\n\nreturn [{ json: { htmlBody: html } }];"
      },
